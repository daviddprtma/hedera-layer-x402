# ===== Resource server (holds NO private key) =====
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=http://localhost:4020
PAY_TO_ACCOUNT=0.0.XXXX

# ===== Demo wallet (browser playground only) =====
# Pre-funded testnet ECDSA account for the demo client
# WARNING: Never use real mainnet keys here!
NEXT_PUBLIC_DEMO_CLIENT_ID=0.0.YYYY
NEXT_PUBLIC_DEMO_CLIENT_KEY=your_ecdsa_hex_private_key

# ===== Facilitator (holds fee-payer key) =====
FACILITATOR_PORT=4020
FACILITATOR_ACCOUNT_ID=0.0.ZZZZ
FACILITATOR_PRIVATE_KEY=your_facilitator_ecdsa_hex_private_key
X402_NETWORK=hedera:testnet

# ===== Mirror Node =====
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ===== How to get testnet accounts =====
# 1. Go to https://portal.hedera.com
# 2. Create an account and fund with testnet HBAR
# 3. Create 3 accounts: PAY_TO (receiver), CLIENT (demo payer), FACILITATOR (fee-payer)
# 4. Use ECDSA keys for all three (required for x402 Hedera scheme)
